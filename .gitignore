# results journal — untracked by design so experience survives `git reset`
results.tsv
# but DO track frozen snapshots under versions/
!versions/**/results.tsv

# run logs — every experiment writes run.log, never commit
run.log
*.log
# but DO track frozen run-log snapshots under versions/
!versions/**/run.log
!versions/**/*.log

# Downloaded data
data/

# Python / uv
__pycache__/
*.pyc
.venv/
.python-version.lock

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Jupyter
.ipynb_checkpoints/

# Research helper caches
investigations/.cache/

# Large research JSON remains local; compressed archive is tracked instead.
strategy_catalog/bottom_signal_2022_2026_research/bottom_signal_results_2022_2026_miss_expanded.json

# Claude Code
.review-result.md
.audit-result.md
.test-result.md
.implement-progress.md
.release-notes.md
